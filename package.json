{
  "name": "exclusive",
  "version": "1.0.0",
  "private": true,
  "description": "Exclusive — Sistema web de comercio electrónico y gestión de ventas de ropa en Guatemala (arquitectura de microservicios)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "check": "node scripts/check-setup.js",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:sql": "node database/generator/generate.js",
    "dev": "concurrently -k -n gateway,auth,catalog,inventory,sales,analytics,web -c gray,magenta,blue,yellow,green,cyan,white \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:catalog\" \"npm:dev:inventory\" \"npm:dev:sales\" \"npm:dev:analytics\" \"npm:dev:web\"",
    "dev:gateway": "npm run dev -w @exclusive/gateway",
    "dev:auth": "npm run dev -w @exclusive/auth-service",
    "dev:catalog": "npm run dev -w @exclusive/catalog-service",
    "dev:inventory": "npm run dev -w @exclusive/inventory-service",
    "dev:sales": "npm run dev -w @exclusive/sales-service",
    "dev:analytics": "npm run dev -w @exclusive/analytics-service",
    "dev:web": "npm run dev -w @exclusive/frontend",
    "build": "npm run build -w @exclusive/frontend",
    "start": "concurrently -k -n gateway,auth,catalog,inventory,sales,analytics -c gray,magenta,blue,yellow,green,cyan \"npm:start:gateway\" \"npm:start:auth\" \"npm:start:catalog\" \"npm:start:inventory\" \"npm:start:sales\" \"npm:start:analytics\"",
    "start:gateway": "npm start -w @exclusive/gateway",
    "start:auth": "npm start -w @exclusive/auth-service",
    "start:catalog": "npm start -w @exclusive/catalog-service",
    "start:inventory": "npm start -w @exclusive/inventory-service",
    "start:sales": "npm start -w @exclusive/sales-service",
    "start:analytics": "npm start -w @exclusive/analytics-service",
    "test:db": "node scripts/create-test-db.js",
    "test": "node scripts/run-tests.js all",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "perf": "node scripts/load-test.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "docs:api": "node scripts/build-openapi.js"
  },
  "devDependencies": {
    "@prisma/prisma-schema-wasm": "^7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "concurrently": "^9.2.1",
    "prisma": "6.19.3"
  }
}
